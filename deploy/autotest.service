# Autotest Service systemd 用户服务（评测宿主机常驻，HTTP 运维面 :2335）
#
# 面构成（同一进程、同一串行队列，v1.5 §4.8）：
#   - tzcomm 面：runner 上 `python3 -m autotest.client run/pause/step/resume` 的本机通路
#     （v1.3 §2 硬约束：client 与 server 同机）；
#   - HTTP 面：:2335 /health、/api/submit、/api/command、/api/jobs/{id}（运维/联调入口）
#     + v1.5 §4.8 ATP 对外端点：POST/GET /atp/evaluations、GET /atp/health（Hub 直连通路）。
#
# 前提：
#   1) tzcomm daemon 常驻——归 TzComm 工程管理（系统级 unit）：
#      sudo <TzComm>/install/setup.sh central --addr 127.0.0.1:17888 --user $USER --yes
#      （用户级 unit 无法对系统级 unit 声明 After/DependsOn，故此处不排序；
#        daemon 未就绪时本服务启动失败，靠 Restart=on-failure 自动重试追上）
#   2) autotest 包可 import：pip3 install --user -e <本仓库>（R5，runner 同机亦满足）；
#   3) 2335 端口空闲（2333=PMS、2334=cicd-hub 已占用）。
#
# v1.5 X3 三件套（Hub 直连通路的密钥/回调配置，token 不入库）：
#   创建 %h/.config/autotest/atp.env（chmod 600），内容：
#     ATP_SERVICE_TOKEN=<Hub→ATP Bearer，O3 分发，每 ATP 一枚>
#     HUB_CALLBACK_URL=<Hub 回调地址，如 http://<hub-host>:2334/api/ci/callback>
#     HUB_CALLBACK_TOKEN=<ATP→Hub Bearer，即 Hub 的 callback_token>
#   未配置时：/atp/* 认证端点 503（端点关闭），回调跳过发送（评测不受影响）。
#   可选：ATP_CACHE_ROOT（mirror/worktree 根，缺省 ~/.cache/autotest）、
#         ATP_WORKTREE_KEEP=1（保留 worktree 现场排查）、ATP_GIT_BASE（owner/repo 简写前缀）。
#
# M-E11 飞书登录（/console 人通道，与 Bearer 机器通道并存；可选项，不配则仅机器通道可用）：
#   atp.env 追加 FEISHU_APP_ID / FEISHU_APP_SECRET（与 Hub/PMS 同一只自建应用即可，O3 分发）；
#   飞书后台登记回调 http://<atp-host 或域名>/api/auth/feishu/callback（按访问 Host 各自登记）；
#   白名单 %h/.config/autotest/console_users.json（chmod 600）：
#     {"users": [{"name": "张三", "oauth_open_id": "ou_xxx"(可空,首登回填), "role": "admin|member"}]}
#   读（列表/详情）= member+，写（手动触发评测）= admin；会话落 sessions.json（600，14 天）。
#
# 安装（仓库里这份是源文件，改动后需重新拷贝安装）：
#   mkdir -p ~/.config/systemd/user
#   cp deploy/autotest.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now autotest
#
# 日常：
#   systemctl --user restart autotest        # 重启（代码更新后生效方式）
#   systemctl --user status autotest         # 状态
#   journalctl --user -u autotest -f         # 日志（含评测/调试命令/通信告警）
#   curl -s localhost:2335/atp/health        # ATP 探活（ok/version/tzcomm/queue）

[Unit]
Description=Autotest Service (tzcomm 评测面 + HTTP 运维面/ATP v1.5 面 :2335)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/turingzero/ws/autotest.dir
# lark-cli 等用户工具在 ~/.local/bin，服务环境不继承 shell PATH，须显式给出
Environment=PATH=/home/turingzero/.local/bin:/usr/local/bin:/usr/bin:/bin
# 显式清空代理：避免继承失效代理导致异常（patrolbox 先例）
Environment=HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= ALL_PROXY= all_proxy=
# HTTP 面端口（默认 2335）；artifacts 默认落 <WorkingDirectory>/artifacts/
Environment=AUTOTEST_HTTP_PORT=2335
# v1.5 X3 三件套（'-' 前缀 = 文件缺失不报错，端点按 503/跳过回调语义降级）
EnvironmentFile=-%h/.config/autotest/atp.env
ExecStart=/usr/bin/python3 -m autotest.server.http
# 异常退出自动拉起；正常 stop/restart 不受影响
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target

# Autotest Service systemd 用户服务（评测宿主机常驻，HTTP 运维面 :2335）
#
# 面构成（同一进程、同一 Jobs 池）：
#   - tzcomm 面：runner 上 `python3 -m autotest.client run/pause/step/resume` 的本机通路
#     （v1.3 §2 硬约束：client 与 server 同机；Hub 触发走 workflow_dispatch，不经本面）；
#   - HTTP 面：:2335 /health、/api/submit、/api/command、/api/jobs/{id}（运维/联调入口）。
#
# 前提：
#   1) tzcomm daemon 常驻——归 TzComm 工程管理（系统级 unit）：
#      sudo <TzComm>/install/setup.sh central --addr 127.0.0.1:17888 --user $USER --yes
#      （用户级 unit 无法对系统级 unit 声明 After/DependsOn，故此处不排序；
#        daemon 未就绪时本服务启动失败，靠 Restart=on-failure 自动重试追上）
#   2) autotest 包可 import：pip3 install --user -e <本仓库>（R5，runner 同机亦满足）；
#   3) 2335 端口空闲（2333=PMS、2334=cicd-hub 已占用）。
#
# 安装（仓库里这份是源文件，改动后需重新拷贝安装）：
#   mkdir -p ~/.config/systemd/user
#   cp deploy/autotest.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now autotest
#
# 日常：
#   systemctl --user restart autotest        # 重启
#   systemctl --user status autotest         # 状态
#   journalctl --user -u autotest -f         # 日志（含评测/调试命令/通信告警）
#   curl -s localhost:2335/health            # 健康检查

[Unit]
Description=Autotest Service (tzcomm 评测面 + HTTP 运维面 :2335)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/turingzero/ws/autotest.dir
# lark-cli 等用户工具在 ~/.local/bin，服务环境不继承 shell PATH，须显式给出
Environment=PATH=/home/turingzero/.local/bin:/usr/local/bin:/usr/bin:/bin
# 显式清空代理：避免继承失效代理导致异常（patrolbox 先例）
Environment=HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= ALL_PROXY= all_proxy=
# HTTP 面端口（默认 2335）；artifacts 默认落 <WorkingDirectory>/artifacts/
Environment=AUTOTEST_HTTP_PORT=2335
ExecStart=/usr/bin/python3 -m autotest.server.http
# 异常退出自动拉起；正常 stop/restart 不受影响
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
